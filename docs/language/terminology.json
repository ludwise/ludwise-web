  "conflicts": [
    {
      "id": "catalog-spelling",
      "status": "resolved",
      "concept": "The set of canonical games.",
      "candidates": ["catalog", "catalogue"],
      "resolution": "catalog",
      "evidence": [
        "The backend names the module Catalog in its architecture document.",
        "README.md and src/pages/games.astro write the other spelling.",
        "The two repositories must not disagree about one concept."
      ],
      "phase2": "Correct the prose in both repositories. A route rename is a product decision and is out of scope for the language work."
    },
    {
      "id": "provider-overload",
      "status": "resolved",
      "concept": "Two different things share one noun in this repository.",
      "candidates": [
        "provider (a store or price source such as Steam)",
        "provider (an analytics transport)"
      ],
      "resolution": "provider",
      "evidence": [
        "docs/architecture.md uses provider for a data source that the backend reads.",
        "tests/unit/analytics/providers.test.ts uses provider for a transport implementation, and src/lib/analytics/ carries the same sense."
      ],
      "phase2": "The noun provider keeps the data-source meaning, which is the one the backend contract and every architecture document use. The analytics sense becomes the analytics transport, which is what it does and which no other concept claims. It was already the word the analytics comments reached for. Identifiers keep their names: AnalyticsProvider already carries the qualifier, so the type is unambiguous where it is written, and a rename is a code change rather than a language change."
    },
    {
      "id": "surface-or-region",
      "status": "resolved",
      "concept": "A named area of the interface.",
      "candidates": ["surface", "region"],
      "resolution": "surface",
      "evidence": [
        "docs/design-system.md writes surface for a distinct place in the interface.",
        "The vendored layout guideline writes region for an area of a page.",
        "The vendored text is exempt, so only the LUDWISE prose is in scope."
      ],
      "phase2": "LUDWISE prose writes surface for a named area of the interface. The design tokens already name it that way in color-semantic.css, which is the layer every component reads. The noun region stays only where it names the ARIA landmark role, because that name is fixed by the accessibility standard rather than by LUDWISE. The vendored handoff under design/ is exempt and is not edited."
    }
  ]
