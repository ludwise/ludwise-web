---
/**
 * Reference: design/system/components/actions.md § IconButton — prop contract
 * ported verbatim.
 *
 * Static, for the same reason Button is: the glyph and the state render on the
 * server, and the handler belongs to the island or the form that owns the
 * action. `href` renders an anchor, as it does on Button.
 */
import Icon from '../foundation/Icon.astro';
import type { IconName } from '../foundation/icons.js';

type IconButtonSize = 'sm' | 'md' | 'lg';

interface Props {
  icon: IconName;
  /** Required. Becomes both aria-label and the tooltip. An icon button with no
   *  label is a defect — screen readers announce nothing. */
  label: string;
  variant?: 'ghost' | 'secondary' | 'primary' | undefined;
  /** sm 32 desktop-toolbar only; md 40 default; lg 44 for touch surfaces. */
  size?: IconButtonSize | undefined;
  /** Toggle buttons only (theme switch, view density, wishlist). */
  pressed?: boolean | undefined;
  disabled?: boolean | undefined;
  href?: string | undefined;
  class?: string | undefined;
}

const {
  icon,
  label,
  variant = 'ghost',
  size = 'md',
  pressed,
  disabled = false,
  href,
  class: className,
} = Astro.props;

const GLYPH_SIZE: Record<IconButtonSize, number> = { sm: 14, md: 16, lg: 20 };

const Tag = href === undefined ? 'button' : 'a';
/** Astro cannot narrow a dynamic tag's attributes, so the set is widened. */
const tagProps: Record<string, string | boolean | undefined> =
  href === undefined
    ? { type: 'button', disabled }
    : { href: disabled ? undefined : href, 'aria-disabled': disabled ? 'true' : undefined };
---

<Tag
  class:list={['lw-icon-button', className]}
  data-variant={variant}
  data-size={size}
  aria-label={label}
  title={label}
  aria-pressed={pressed === undefined ? undefined : pressed ? 'true' : 'false'}
  {...tagProps}
>
  <Icon name={icon} size={GLYPH_SIZE[size]} />
</Tag>

<style>
  .lw-icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: var(--border-width-hairline) solid transparent;
    border-radius: var(--radius-button);
    background: transparent;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: var(--motion-transition-color);
  }
  .lw-icon-button[data-size='sm'] {
    width: 32px;
    height: 32px;
  }
  .lw-icon-button[data-size='lg'] {
    width: var(--target-min-touch);
    height: var(--target-min-touch);
  }

  .lw-icon-button[data-variant='secondary'] {
    border-color: var(--color-border-component);
  }
  .lw-icon-button[data-variant='primary'] {
    background: var(--color-action-primary);
    color: var(--color-action-primary-text);
  }
  .lw-icon-button:hover {
    background: var(--color-surface-interactive-hover);
  }
  .lw-icon-button[data-variant='primary']:hover {
    background: var(--color-action-primary-hover);
  }
  /* Selected is never colour alone: aria-pressed carries the same fact. */
  .lw-icon-button[aria-pressed='true'] {
    background: var(--color-surface-selected);
    color: var(--color-text-primary);
  }

  .lw-icon-button:disabled,
  .lw-icon-button[aria-disabled='true'] {
    background: transparent;
    color: var(--color-action-disabled-text);
    cursor: not-allowed;
  }
</style>
