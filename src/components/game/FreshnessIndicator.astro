---
/**
 * How current one price is, in the backend's word and the phrase for its age.
 *
 * `src/lib/state/freshness.ts` turns the word into what renders here. This
 * component draws it and decides nothing, so a row and its page cannot disagree.
 */
import Icon from '../foundation/Icon.astro';
import type { IconName } from '../foundation/icons.js';
import { formatObservationTimestamp } from '../../lib/formatting/freshness.js';
import { offerFreshnessView, type OfferFreshnessState } from '../../lib/state/freshness.js';
import type { FreshnessView } from './view-models.js';

type Props = FreshnessView;

const { nowMs, ...offer } = Astro.props;
const view = offerFreshnessView(offer, nowMs ?? Date.now());

const absolute = view.observedAtMs === null ? null : formatObservationTimestamp(view.observedAtMs);
const iso = view.observedAtMs === null ? null : new Date(view.observedAtMs).toISOString();

/** `recently_verified` draws the solid dot instead of a glyph. */
const ICONS: Record<OfferFreshnessState, IconName | null> = {
  recently_verified: null,
  stale: 'clock-fading',
  never_verified: 'circle-question-mark',
  not_provided: 'circle-question-mark',
  unavailable: 'circle-alert',
};
const icon = ICONS[view.state];
---

<span class="lw-freshness" data-state={view.state} title={absolute ?? undefined}>
  {icon ? <Icon name={icon} size="sm" /> : <span class="lw-freshness__dot" aria-hidden="true" />}
  <span class="lw-freshness__text">
    {
      view.warning && (
        <span class="lw-freshness__warning">
          {view.warning}
          <span class="lw-visually-hidden">.</span>
        </span>
      )
    }
    {iso ? <time datetime={iso}>{view.phrase}</time> : <span>{view.phrase}</span>}
  </span>
  {absolute && <span class="lw-visually-hidden">Exact time: {absolute}</span>}
</span>

<style>
  .lw-freshness {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    max-width: 100%;
    min-width: 0;
    color: var(--color-text-secondary);
    font: var(--text-caption);
    line-height: 1.35;
  }
  .lw-freshness__text {
    display: inline-flex;
    flex-wrap: wrap;
    column-gap: var(--space-2);
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .lw-freshness__warning {
    color: var(--color-text-primary);
  }
  .lw-freshness__dot {
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: var(--radius-full);
    background: var(--color-freshness-fresh);
  }
</style>
