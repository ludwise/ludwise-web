---
/**
 * How old one observation is, in words.
 *
 * `src/lib/state/freshness.ts` owns the age boundaries. A page reads the same
 * ones to decide whether it may present itself as current. A second copy here
 * would let a row and its page disagree.
 */
import Icon from '../foundation/Icon.astro';
import { formatObservationTimestamp } from '../../lib/formatting/freshness.js';
import {
  FRESHNESS_DAY_MS,
  FRESHNESS_HOUR_MS,
  FRESHNESS_MINUTE_MS,
  FRESHNESS_WEEK_MS,
  type FreshnessLevel,
  freshnessLevel,
  observationAgeMs,
} from '../../lib/state/freshness.js';

interface Props {
  availability: 'available' | 'unavailable' | 'unknown' | null;
  observedAtMs: number | null;
  storeName: string;
  /** SSR test time. Production callers omit it. */
  nowMs?: number | undefined;
}

const { availability, observedAtMs, storeName, nowMs } = Astro.props;
const now = nowMs ?? Date.now();
const level = freshnessLevel({ availability, observedAtMs, nowMs: now });
const ageMs = observationAgeMs(observedAtMs, now);

function labelFor(state: FreshnessLevel, age: number | null, store: string): string {
  if (state === 'unavailable') return `${store} temporarily unavailable`;
  if (age === null) return 'Freshness not provided';
  if (state === 'fresh') {
    return age < FRESHNESS_MINUTE_MS
      ? 'Updated just now'
      : `Updated ${Math.floor(age / FRESHNESS_MINUTE_MS)} min ago`;
  }
  if (state === 'aging') return `Checked ${Math.floor(age / FRESHNESS_HOUR_MS)} hours ago`;
  return age < FRESHNESS_WEEK_MS
    ? `Last checked ${Math.floor(age / FRESHNESS_DAY_MS)} days ago`
    : 'Price may be out of date';
}

const label = labelFor(level, ageMs, storeName);

const absolute = observedAtMs === null ? null : formatObservationTimestamp(observedAtMs);
const iso = observedAtMs === null ? null : new Date(observedAtMs).toISOString();
const icon =
  level === 'unavailable'
    ? 'circle-alert'
    : level === 'stale'
      ? 'clock-fading'
      : level === 'unknown'
        ? 'circle-question-mark'
        : null;
---

<span class="lw-freshness" data-level={level} title={absolute ?? undefined}>
  {icon ? <Icon name={icon} size="sm" /> : <span class="lw-freshness__dot" aria-hidden="true" />}
  {iso ? <time datetime={iso}>{label}</time> : <span>{label}</span>}
  {absolute && <span class="lw-visually-hidden">Exact time: {absolute}</span>}
</span>

<style>
  .lw-freshness {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    max-width: 100%;
    min-width: 0;
    color: var(--color-text-secondary);
    font: var(--text-caption);
    line-height: 1.35;
  }
  .lw-freshness > time,
  .lw-freshness > span:not(.lw-visually-hidden) {
    overflow-wrap: anywhere;
  }
  .lw-freshness[data-level='stale'] {
    color: var(--color-text-secondary);
  }
  .lw-freshness[data-level='unavailable'] {
    color: var(--color-text-secondary);
  }
  .lw-freshness__dot {
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: var(--radius-full);
    background: var(--color-freshness-fresh);
  }
  .lw-freshness[data-level='aging'] .lw-freshness__dot {
    background: transparent;
    border: 1.5px solid var(--color-freshness-aging);
  }
</style>
