---
import { formatNumber, formatPercentFromWhole } from '../../i18n/format.js';
import { messages as m, resolveLocale } from '../../i18n/index.js';

interface Props {
  percentage?: number | null | undefined;
  size?: 'sm' | 'md' | undefined;
}

const { percentage, size = 'md' } = Astro.props;
const rounded = percentage == null ? null : Math.round(percentage);
const locale = resolveLocale(Astro.currentLocale);
const messageOptions = { locale } as const;
const visualText = rounded === null ? null : formatPercentFromWhole(-rounded, locale);
const accessibleText =
  rounded === null
    ? null
    : m.price_percent_off({ percentage: formatNumber(rounded, locale) }, messageOptions);
---

{
  rounded !== null && rounded > 0 && visualText !== null && accessibleText !== null && (
    <span class="lw-discount-badge" data-size={size} aria-label={accessibleText}>
      {visualText}
    </span>
  )
}

<style>
  .lw-discount-badge {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding-inline: var(--space-2);
    border: var(--border-width-hairline) solid var(--color-discount-border);
    border-radius: var(--radius-badge);
    background: var(--color-discount-surface);
    color: var(--color-discount-text);
    font: var(--text-label-md);
    letter-spacing: var(--letter-spacing-label);
    font-variant-numeric: tabular-nums lining-nums;
    white-space: nowrap;
  }
  .lw-discount-badge[data-size='sm'] {
    min-height: 20px;
    font: var(--text-label-sm);
  }
</style>
