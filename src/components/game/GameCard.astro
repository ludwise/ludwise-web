---
/**
 * Reference: design/system/components/game.md § GameCard — the discovery
 * primitive: one game, its artwork, and its best current offer.
 *
 * The content hierarchy is ported verbatim and never reordered: identity,
 * purchasable state, price, deal context, secondary metadata. The whole card is
 * one link with no nested control, linking to the canonical game page.
 *
 * `ratingSummary`, `signal` and `variant` are deliberately not implemented:
 * the data does not exist, and PRODUCT.md §120 forbids rendering a value that
 * is not there. docs/design-system.md records each difference from the handoff.
 */
import GameArtwork from './GameArtwork.astro';
import Price from './Price.astro';
import FreshnessIndicator from './FreshnessIndicator.astro';
import StoreIdentity from './StoreIdentity.astro';
import type { GameCardView } from './view-models.js';

type Props = GameCardView;

const { title, href, artworkSrc, offer, storeCount, releaseDate } = Astro.props;

const releaseYear =
  releaseDate === null || releaseDate === undefined ? null : releaseDate.slice(0, 4);
const editionLabel = offer?.editionLabel ?? null;
---

<a class="lw-game-card" href={href}>
  {
    artworkSrc !== undefined && (
      <GameArtwork
        class="lw-game-card__artwork"
        src={artworkSrc ?? undefined}
        title={title}
        ratio="capsule"
        radius="0"
      />
    )
  }

  <div class="lw-game-card__body">
    <h3 class="lw-game-card__title">{title}</h3>

    {
      offer === null ? (
        <p class="lw-game-card__no-offer">No price in this region</p>
      ) : (
        <Fragment>
          <p class="lw-game-card__stores">
            <StoreIdentity name={offer.storeName} />
            {storeCount !== undefined && storeCount > 1 && (
              <span class="lw-game-card__store-more">and {storeCount - 1} more</span>
            )}
          </p>

          <div class="lw-game-card__price">
            <Price
              price={offer.price}
              referencePrice={offer.referencePrice}
              discountPercentage={offer.discountPercentage}
              availability="available"
            />
          </div>
        </Fragment>
      )
    }

    {
      (editionLabel || releaseYear) && (
        <p class="lw-game-card__meta">
          {editionLabel && <span>{editionLabel}</span>}
          {editionLabel && releaseYear && <span aria-hidden="true">·</span>}
          {releaseYear && <span>Released {releaseYear}</span>}
        </p>
      )
    }

    {
      offer !== null && (
        <div class="lw-game-card__freshness">
          <FreshnessIndicator
            availability="available"
            freshness={offer.freshness}
            observedAtMs={offer.observedAtMs}
            storeName={offer.storeName}
          />
        </div>
      )
    }
  </div>
</a>

<style>
  .lw-game-card {
    display: flex;
    flex-direction: column;
    block-size: 100%;
    min-inline-size: 0;
    overflow: hidden;
    border: var(--border-width-hairline) solid var(--color-border-component);
    border-radius: var(--radius-card);
    background: var(--color-surface-default);
    color: inherit;
    text-decoration: none;
    transition: var(--motion-transition-color);
  }

  .lw-game-card:hover {
    background: var(--color-surface-interactive-hover);
  }

  /* The card border already frames the picture, so a second hairline would double it. */
  .lw-game-card :global(.lw-game-card__artwork) {
    border: 0;
  }

  .lw-game-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-2);
    min-inline-size: 0;
    padding: var(--space-4);
  }

  .lw-game-card__title {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    color: var(--color-text-primary);
    font: var(--text-heading-sm);
    letter-spacing: var(--letter-spacing-heading);
    text-wrap: pretty;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .lw-game-card__stores {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    margin: 0;
    min-inline-size: 0;
  }

  /* Secondary rather than the tertiary the handoff's mock uses for this line:
     at caption size, tertiary on the default surface measures 4.19:1, below
     the 4.5:1 WCAG 1.4.3 asks for. */
  .lw-game-card__store-more {
    color: var(--color-text-secondary);
    font: var(--text-caption);
    white-space: nowrap;
  }

  /* Pushed to the bottom so a two-line title and a one-line title leave the
     price on the same baseline across a row of cards. */
  .lw-game-card__price,
  .lw-game-card__no-offer {
    display: flex;
    justify-content: flex-start;
    margin-block-start: auto;
    padding-block-start: var(--space-2);
  }

  .lw-game-card__no-offer {
    color: var(--color-text-secondary);
    font: var(--text-body-sm);
  }

  .lw-game-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0;
    color: var(--color-text-secondary);
    font: var(--text-caption);
    overflow-wrap: anywhere;
  }
</style>
