---
/**
 * Reference: design/system/components/game.md § GameCard — the discovery
 * primitive: one game and its best current offer.
 *
 * The content hierarchy is ported verbatim and never reordered: identity,
 * purchasable state, price, deal context, secondary metadata. The whole card is
 * one link with no nested control — a control inside a card "creates a keyboard
 * trap and an ambiguous click target" — linking to the canonical game page.
 *
 * `artworkSrc`, `ratingSummary`, `signal` and `variant` are deliberately not
 * implemented: the data does not exist, and PRODUCT.md §120 forbids rendering a
 * value that is not there. `observedAtMs` and `editionLabel` are additions
 * PRODUCT.md §55 and §37 require. design/system/components/game.md holds the
 * full prop-by-prop record.
 */
import Price from './Price.astro';
import FreshnessIndicator from './FreshnessIndicator.astro';
import StoreIdentity from './StoreIdentity.astro';

/** Structural, so both the sales and game-detail money views satisfy it. */
interface CardMoney {
  amountMinor: number;
  currencyCode: string;
  minorUnit: number;
}

interface Props {
  title: string;
  /** The canonical game page. Always internal — the card never links to a store. */
  href: string;
  price: CardMoney;
  referencePrice: CardMoney | null;
  discountPercentage: number | null;
  /** How many stores currently hold a qualifying offer. */
  storeCount: number;
  /** Named only when the represented offer is not the plain base game. */
  editionLabel?: string | null | undefined;
  /** Reduced-precision RFC 3339, so the year is the leading four characters. */
  releaseDate?: string | null | undefined;
  observedAtMs: number;
  storeName: string;
}

const {
  title,
  href,
  price,
  referencePrice,
  discountPercentage,
  storeCount,
  editionLabel,
  releaseDate,
  observedAtMs,
  storeName,
} = Astro.props;

const releaseYear =
  releaseDate === null || releaseDate === undefined ? null : releaseDate.slice(0, 4);
---

<a class="lw-game-card" href={href}>
  <h3 class="lw-game-card__title">{title}</h3>

  <p class="lw-game-card__stores">
    <StoreIdentity name={storeName} />
    {storeCount > 1 && <span class="lw-game-card__store-more">and {storeCount - 1} more</span>}
  </p>

  <div class="lw-game-card__price">
    <Price
      price={price}
      referencePrice={referencePrice}
      discountPercentage={discountPercentage}
      availability="available"
    />
  </div>

  {
    (editionLabel || releaseYear) && (
      <p class="lw-game-card__meta">
        {editionLabel && <span>{editionLabel}</span>}
        {editionLabel && releaseYear && <span aria-hidden="true">·</span>}
        {releaseYear && <span>Released {releaseYear}</span>}
      </p>
    )
  }

  <div class="lw-game-card__freshness">
    <FreshnessIndicator
      availability="available"
      observedAtMs={observedAtMs}
      storeName={storeName}
    />
  </div>
</a>

<style>
  .lw-game-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-inline-size: 0;
    padding: var(--space-4);
    border: var(--border-width-hairline) solid var(--color-border-component);
    border-radius: var(--radius-card);
    background: var(--color-surface-default);
    color: inherit;
    text-decoration: none;
    transition: var(--motion-transition-color);
  }

  .lw-game-card:hover {
    border-color: var(--color-border-component);
  }

  .lw-game-card__title {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    color: var(--color-text-primary);
    font: var(--text-heading-sm);
    letter-spacing: var(--letter-spacing-heading);
    text-wrap: pretty;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .lw-game-card__stores {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    margin: 0;
    min-inline-size: 0;
  }

  /* Secondary rather than the tertiary the handoff's mock uses for this line:
     at caption size, tertiary on the default surface measures 4.19:1, below
     the 4.5:1 WCAG 1.4.3 asks for. Caught by the accessibility gate, not by
     eye. */
  .lw-game-card__store-more {
    color: var(--color-text-secondary);
    font: var(--text-caption);
    white-space: nowrap;
  }

  /* Pushed to the bottom so a two-line title and a one-line title leave the
     price on the same baseline across a row of cards. */
  .lw-game-card__price {
    display: flex;
    justify-content: flex-start;
    margin-block-start: auto;
    padding-block-start: var(--space-2);
  }

  .lw-game-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0;
    color: var(--color-text-secondary);
    font: var(--text-caption);
    overflow-wrap: anywhere;
  }
</style>
