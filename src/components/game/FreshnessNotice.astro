---
/**
 * What a page of offers says about its own prices, above the results.
 *
 * One statement for the surface, beside the per-row `FreshnessIndicator`.
 * `design/system/guidelines/content-style.md` § Errors carries the form:
 * what happened, then what you are seeing instead.
 *
 * Renders only when the page word is `stale`. `surfaceFreshness` composes that
 * word from the backend's offer words.
 */
import InlineMessage from '../feedback/InlineMessage.astro';
import { formatObservationTime } from '../../lib/formatting/freshness.js';
import type { SurfaceFreshness } from '../../lib/state/freshness.js';

interface Props {
  freshness: SurfaceFreshness;
  nowMs: number;
}

const { freshness, nowMs } = Astro.props;

const oldestCheckedAt =
  freshness.oldestStaleObservedAtMs === null
    ? null
    : formatObservationTime(freshness.oldestStaleObservedAtMs, nowMs);
---

{
  freshness.word === 'stale' && (
    <InlineMessage tone="warning" title="These prices may be out of date">
      {oldestCheckedAt === null
        ? 'A store may have changed a price since LUDWISE last checked it.'
        : `The oldest price on this page was checked ${oldestCheckedAt}. A store may have changed it since.`}
    </InlineMessage>
  )
}
