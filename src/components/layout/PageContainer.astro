---
// NOT part of the design handoff. design/system/guidelines/layout.md
// documents three max-width archetypes and the gutter scale — "Two page
// archetypes" and the breakpoint table — but the bundle ships no component
// for the wrapper itself. This implements that written rule so pages do not
// each reimplement the max-width/gutter math by hand.
//
// Gutter breakpoints (768/1024) are not spelt out in layout.md for this
// specific rule; they are chosen to match the existing `md`/`lg` breakpoint
// tokens already defined in tokens/layout.css, so this component tracks the
// same scale as everything else rather than inventing its own.
interface Props {
  /** wide = visual discovery, 1440 (sales, browse, search-as-grid) ·
   *  standard = data comparison, 1200, default (game detail, offers,
   *  account) · reading = editorial, 720 (docs, legal). */
  width?: 'wide' | 'standard' | 'reading' | undefined;
  class?: string | undefined;
}

const { width = 'standard', class: className } = Astro.props;
---

<div class:list={['lw-page-container', className]} data-width={width}>
  <slot />
</div>

<style>
  .lw-page-container {
    margin-inline: auto;
    padding-inline: var(--layout-gutter-mobile);
  }
  .lw-page-container[data-width='wide'] {
    max-width: var(--layout-max-width-wide);
  }
  .lw-page-container[data-width='standard'] {
    max-width: var(--layout-max-width-standard);
  }
  .lw-page-container[data-width='reading'] {
    max-width: var(--layout-max-width-reading);
  }
  @media (min-width: 768px) {
    .lw-page-container {
      padding-inline: var(--layout-gutter-tablet);
    }
  }
  @media (min-width: 1024px) {
    .lw-page-container {
      padding-inline: var(--layout-gutter-desktop);
    }
  }
</style>
