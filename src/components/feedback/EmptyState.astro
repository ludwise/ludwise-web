---
/**
 * Reference: design/system/components/feedback.md § EmptyState — prop contract
 * ported verbatim. Every empty state answers three questions in order: what
 * happened, why the space is empty, what to do next. That order is carried by
 * title/default-slot/action, not by validation.
 *
 * `children`, `action` and `secondaryAction` are ReactNode in the reference; as
 * in InlineMessage they become the default slot and two named slots.
 *
 * `titleAs` is an addition, not in the handoff's prop contract. The bundle ships
 * no error-page composition, so nothing in it needed the title to be a heading —
 * but `/404` and `/500` compose from EmptyState, where the title is the only
 * heading-styled text on the page. A bare `<span>` leaves a screen-reader user
 * navigating by heading with nothing to land on (WCAG 1.3.1). Defaults to
 * `'span'`, so in-page uses gain no stray heading.
 */
import Icon from '../foundation/Icon.astro';
import type { IconName } from '../foundation/icons.js';

interface Props {
  icon?: IconName | undefined;
  /** States the fact, e.g. "No games match these filters". */
  title: string;
  /** Element the title renders as. Default 'span' matches every existing
   *  in-page use; pass a heading level only where this IS the page's
   *  heading, e.g. an error page composed entirely from EmptyState. */
  titleAs?: 'span' | 'h1' | 'h2' | 'h3' | undefined;
  compact?: boolean | undefined;
}

const { icon = 'search', title, titleAs = 'span', compact = false } = Astro.props;

const hasActions = Astro.slots.has('action') || Astro.slots.has('secondaryAction');

/**
 * Astro takes a dynamic tag from a capitalised variable, the technique
 * Wordmark.astro uses for its href-or-not `<a>`/`<span>`. The class below sets
 * the full font shorthand whatever the tag, so only the semantics change.
 */
const TitleTag = titleAs;
---

<div class="lw-empty-state" data-compact={compact || undefined}>
  <span class="lw-empty-state__icon">
    <Icon name={icon} size="xl" />
  </span>
  <TitleTag class="lw-empty-state__title">{title}</TitleTag>
  <span class="lw-empty-state__body"><slot /></span>
  {
    hasActions && (
      <div class="lw-empty-state__actions">
        <slot name="action" />
        <slot name="secondaryAction" />
      </div>
    )
  }
</div>

<style>
  .lw-empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3);
    padding: var(--space-16) var(--space-6);
    max-width: 480px;
    margin: 0 auto;
  }
  .lw-empty-state[data-compact] {
    padding: var(--space-8) var(--space-4);
  }
  .lw-empty-state__icon {
    color: var(--color-text-tertiary);
  }
  .lw-empty-state__title {
    font: var(--text-heading-sm);
    letter-spacing: var(--letter-spacing-heading);
    color: var(--color-text-primary);
  }
  .lw-empty-state__body {
    font: var(--text-body-md);
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }
  .lw-empty-state__actions {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-2);
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
