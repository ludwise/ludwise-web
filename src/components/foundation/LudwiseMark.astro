---
/**
 * Reference: design/system/components/foundation.md § Wordmark — the
 * `LudwiseMarkProps` contract ported verbatim.
 *
 * The tile mark on its own: favicons, app icons, avatars, square slots. The
 * step is the shape the price chart draws, and it also reads as an L.
 *
 * ./wordmark-geometry.js holds the measurements, which AppHeader.tsx needs too.
 */
import {
  WORDMARK_STEP_PATH,
  WORDMARK_STEP_RATIO,
  WORDMARK_STEP_STROKE_WIDTH,
  WORDMARK_TILE_RADIUS_RATIO,
} from '../foundation/wordmark-geometry.js';

interface Props {
  /** Tile edge in px. The mark floors at 20px, where the treads merge. */
  size?: number | undefined;
  tone?: 'default' | 'inverse' | 'mono' | undefined;
  class?: string | undefined;
}

const { size = 24, tone = 'default', class: className } = Astro.props;

const tileSize = Math.round(size);
const stepSize = tileSize * WORDMARK_STEP_RATIO;
const radius = Math.round(tileSize * WORDMARK_TILE_RADIUS_RATIO);
---

<span
  aria-hidden="true"
  class:list={['lw-mark', className]}
  data-tone={tone}
  style={{ width: `${tileSize}px`, height: `${tileSize}px`, borderRadius: `${radius}px` }}
>
  <svg
    width={stepSize}
    height={stepSize}
    viewBox="0 0 24 24"
    fill="none"
    stroke-width={WORDMARK_STEP_STROKE_WIDTH}
    stroke-linecap="square"
  >
    <path d={WORDMARK_STEP_PATH}></path>
  </svg>
</span>

<style>
  /* Amber tile, near-black step, in both themes. Both tokens hold the same
     value in either theme, and accessibility.md measures the pair at 9.2:1. */
  .lw-mark {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    background: var(--color-accent-primary);
  }
  /* The one primitive this file reaches. `inverse` is for a dark brand surface
     outside the theme system, and the semantic layer holds no light neutral
     that stays light in both themes. governance.md is the route to one. */
  .lw-mark[data-tone='inverse'] {
    background: var(--ludwise-neutral-50);
  }
  .lw-mark[data-tone='mono'] {
    background: currentcolor;
  }
  .lw-mark > svg {
    stroke: var(--color-action-primary-text);
  }
  .lw-mark[data-tone='mono'] > svg {
    stroke: var(--color-background-primary);
  }
</style>
