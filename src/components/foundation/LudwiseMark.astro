---
/**
 * Reference: design/system/components/foundation.md § Wordmark — the
 * `LudwiseMarkProps` contract ported verbatim.
 *
 * The tile mark on its own: favicons, app icons, avatars, square slots. The
 * step is the shape the price chart draws, and it also reads as an L.
 */
interface Props {
  /** Tile edge in px. The mark floors at 20px, where the treads merge. */
  size?: number | undefined;
  tone?: 'default' | 'inverse' | 'mono' | undefined;
  class?: string | undefined;
}

const { size = 24, tone = 'default', class: className } = Astro.props;

const TILE_RADIUS_RATIO = 0.22;
const STEP_RATIO = 0.64;

/**
 * A constant stroke at every size.
 *
 * The prop comment in the bundle says the stroke thickens below 22px. The
 * rules paragraph above it, and the reference implementation, both keep 2.2
 * at every size. The rules paragraph wins.
 */
const STEP_STROKE_WIDTH = 2.2;

const tileSize = Math.round(size);
const stepSize = tileSize * STEP_RATIO;
const radius = Math.round(tileSize * TILE_RADIUS_RATIO);
---

<span
  aria-hidden="true"
  class:list={['lw-mark', className]}
  data-tone={tone}
  style={{ width: `${tileSize}px`, height: `${tileSize}px`, borderRadius: `${radius}px` }}
>
  <svg
    width={stepSize}
    height={stepSize}
    viewBox="0 0 24 24"
    fill="none"
    stroke-width={STEP_STROKE_WIDTH}
    stroke-linecap="square"
  >
    <path d="M4 7h6v5h5v5h5"></path>
  </svg>
</span>

<style>
  /* Amber tile, near-black step, in both themes. Near-black on the amber
     clears 9:1 either way, so the mark is one object and not two designs. */
  .lw-mark {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    background: var(--ludwise-amber-400);
  }
  .lw-mark[data-tone='inverse'] {
    background: var(--ludwise-neutral-50);
  }
  .lw-mark[data-tone='mono'] {
    background: currentcolor;
  }
  .lw-mark > svg {
    stroke: var(--ludwise-neutral-1000);
  }
  .lw-mark[data-tone='mono'] > svg {
    stroke: var(--color-background-primary);
  }
</style>
