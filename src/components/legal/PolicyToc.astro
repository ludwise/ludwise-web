---
import { messages as m, type Locale } from '../../i18n/index.js';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  locale: Locale;
  headings: Heading[];
}

const { locale, headings } = Astro.props;
const messageOptions = { locale } as const;
const items = headings.filter((heading) => heading.depth === 2);
---

{
  items.length > 0 && (
    <nav class="lw-policy-toc" aria-label={m.legal_contents_label({}, messageOptions)}>
      <p class="lw-policy-toc__title">{m.legal_on_this_page({}, messageOptions)}</p>
      <ol>
        {items.map((heading) => (
          <li>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .lw-policy-toc {
    padding: var(--space-5);
    border: 1px solid var(--color-border-component);
    border-radius: var(--radius-card);
    background: var(--color-surface-sunken);
  }

  .lw-policy-toc__title {
    margin: 0 0 var(--space-3);
    color: var(--color-text-primary);
    font: var(--text-label-lg);
  }

  ol {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-left: var(--space-5);
  }

  li {
    color: var(--color-text-secondary);
    font: var(--text-body-sm);
  }

  a {
    color: var(--color-text-link);
    text-underline-offset: 0.18em;
  }

  a:hover {
    color: var(--color-text-link-hover);
  }
</style>
