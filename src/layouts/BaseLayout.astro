---
import { getRelativeLocaleUrl } from 'astro:i18n';

import { AppHeader } from '../components/navigation/AppHeader.tsx';
import SiteFooter from '../components/navigation/SiteFooter.astro';
import { getTextDirection, messages as m, resolveLocale } from '../i18n/index.js';
import type { RegionControlProps } from '../components/region/RegionControl.tsx';
import { isApiError } from '../lib/api/errors.js';
import { formatRegionCodes, formatRegionName, regionOptions } from '../lib/formatting/region.js';
import type { MediaPicture } from '../lib/game/media.js';
import { readHeaderSearch } from '../lib/http/header-search.js';
import { readThemeCookie } from '../lib/http/theme.js';
import type { RegionSource } from '../lib/region/visitor-region.js';
import { pageHead, type PageIndexing } from '../lib/seo/page-head.js';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string | undefined;
  /** Which nav destination is current. Omit on pages outside the nav, for example 404. */
  activeNavId?: string | undefined;
  /**
   * How a crawler treats this page. The default is an indexable page at its
   * pathname. The environment flag can only make it more restrictive.
   */
  indexing?: PageIndexing | undefined;
  /** The game cover that `og:image` names. Omit it on a page with no cover. */
  shareCover?: MediaPicture | null | undefined;
  /** Where a region change returns to. The default is this page, with its query. */
  regionReturnPath?: string | undefined;
}

const { title, description, activeNavId, shareCover, regionReturnPath } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const messageOptions = { locale } as const;

const homeHref = getRelativeLocaleUrl(locale);
const gamesHref = getRelativeLocaleUrl(locale, 'games');
const salesHref = getRelativeLocaleUrl(locale, 'sales');

const navItems = [
  { id: 'home', label: m.shell_navigation_home({}, messageOptions), href: homeHref },
  { id: 'games', label: m.shell_navigation_games({}, messageOptions), href: gamesHref },
  { id: 'sales', label: m.shell_navigation_sales({}, messageOptions), href: salesHref },
];

const headerCopy = {
  primaryNavigationLabel: m.shell_navigation_primary_label({}, messageOptions),
  homeLabel: m.shell_brand_home_label({}, messageOptions),
  searchLabel: m.shell_search_label({}, messageOptions),
  clearSearchLabel: m.shell_search_clear_label({}, messageOptions),
  switchToLightThemeLabel: m.shell_theme_switch_to_light({}, messageOptions),
  switchToDarkThemeLabel: m.shell_theme_switch_to_dark({}, messageOptions),
  accountLabel: m.shell_account_label({}, messageOptions),
  signInLabel: m.shell_sign_in({}, messageOptions),
  menuLabel: m.shell_menu_label({}, messageOptions),
};

// The region control needs the region list. Without it, the header renders
// without the control, and a price-bearing page reports the failure itself.
const REGION_SOURCE_STATEMENTS: Record<RegionSource, () => string> = {
  selected: () => m.shell_region_source_selected({}, messageOptions),
  detected: () => m.shell_region_source_detected({}, messageOptions),
  fallback: () => m.shell_region_source_fallback({}, messageOptions),
};

let region: RegionControlProps | undefined;
try {
  const context = await Astro.locals.visitorRegion();
  region = {
    name: formatRegionName(context.region, locale),
    codes: formatRegionCodes(context.region),
    currentCountryCode: context.region.countryCode,
    options: regionOptions(context.regions, locale),
    action: getRelativeLocaleUrl(locale, 'region'),
    returnTo: regionReturnPath ?? `${Astro.url.pathname}${Astro.url.search}`,
    copy: {
      triggerPrefix: m.shell_region_trigger_prefix({}, messageOptions),
      heading: m.shell_region_heading({}, messageOptions),
      source: REGION_SOURCE_STATEMENTS[context.region.source](),
      refresh: m.shell_region_refresh({}, messageOptions),
      selectLabel: m.shell_region_select_label({}, messageOptions),
      currencyLabel: m.shell_region_currency_label({}, messageOptions),
      noConversion: m.shell_region_no_conversion({}, messageOptions),
      apply: m.shell_region_apply({}, messageOptions),
      cancel: m.shell_region_cancel({}, messageOptions),
    },
  };
} catch (error) {
  if (!isApiError(error)) throw error;
}

// Resolved server-side so the first response carries the right theme. `null` is
// "no preference expressed", which differs from "light": it hands the decision
// to the pre-paint script rather than asserting a preference nobody made.
const theme = readThemeCookie(Astro.request.headers.get('cookie'));

const headerSearch = readHeaderSearch(Astro.url, gamesHref);

// Outside production, the robots element repeats the X-Robots-Tag header for a
// page saved or re-served without it. Neither is a security control. In
// production only an error page or a query variant sends a robots element.
const indexableEnvironment = Astro.locals.config.environment === 'production';
const head = pageHead({
  siteUrl: Astro.locals.config.siteUrl,
  indexableEnvironment,
  indexing: Astro.props.indexing ?? { kind: 'indexable', canonicalPath: Astro.url.pathname },
  title,
  description,
  shareCover,
});
---

<!doctype html>
<html lang={locale} dir={getTextDirection(locale)} data-theme={theme ?? undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {
      /* The two weights that render above the fold on every page: body text at
         400, and headings at 600. Every `h1` uses `--text-heading-xl`, which
         is semibold, and so does the wordmark. Preloading them collapses the
         swap window `font-display: swap` would otherwise leave visible.

         500 is deliberately not preloaded, and this was measured rather than
         guessed. On a throttled connection, preloading 400+500 had the
         headline face arriving at 1,361ms, and 400+600 at 719ms, with 124ms
         better FCP. 500 renders one pill in the header and is discovered from
         the stylesheet like every other weight.

         `crossorigin` is required even same-origin. Fonts are always fetched
         in CORS mode, and without it the preload is discarded and fetched
         twice. */
      ['geist-sans-latin-400-normal', 'geist-sans-latin-600-normal'].map((file) => (
        <link rel="preload" href={`/fonts/${file}.woff2`} as="font" type="font/woff2" crossorigin />
      ))
    }

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {head.robots !== null && <meta name="robots" content={head.robots} />}
    {head.canonical !== null && <link rel="canonical" href={head.canonical} />}
    {head.meta.map((tag) => <meta {...{ [tag.attribute]: tag.key }} content={tag.content} />)}

    {
      /* The design system's logo mark, served verbatim and pinned to it by
         tests/integration/design/asset-parity.test.ts.

         SVG only. A raster fallback would need a rasterisation step and an
         image dependency to produce .ico and apple-touch-icon variants. Also,
         every browser this project supports reads an SVG icon. A browser that
         does not falls back to probing /favicon.ico, gets a 404 and shows its
         own default glyph. That is the same thing it showed before this
         existed. */
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {
      /* Runs before first paint, and only when this Worker had no preference to
         render. Inline rather than a file, because an external script would need
         a round trip. A render-blocking script in <head> exists to avoid that
         round trip, after which the flash has already happened.

         It deliberately does NOT write the cookie. Storing a value on a
         visitor's device with no act on their part is not covered by
         ePrivacy's strictly-necessary exemption. It would not be necessary
         anyway: this script has already resolved and applied the theme for the
         page in front of them. Persisting it would only save *this same
         script* from running on later pages - an optimization, and an
         optimization is not the exemption. So the cookie exists only when the
         visitor used the toggle, which is squarely inside it. The cost is a
         few hundred inline bytes per page for a visitor who never toggles. */
      theme === null && (
        <script is:inline>
          {(() => {
            document.documentElement.dataset.theme = window.matchMedia(
              '(prefers-color-scheme: dark)',
            ).matches
              ? 'dark'
              : 'light';
          })()}
        </script>
      )
    }
  </head>
  <body>
    <a class="lw-skip-link" href="#main-content">{m.shell_skip_to_content({}, messageOptions)}</a>

    <AppHeader
      client:load
      items={navItems}
      activeId={activeNavId}
      homeHref={homeHref}
      copy={headerCopy}
      theme={theme ?? 'light'}
      searchAction={gamesHref}
      searchValue={headerSearch.value}
      searchCarriedParams={headerSearch.carriedParams}
      region={region}
    />

    {
      /* tabindex="-1" so the skip link moves focus rather than only moving the
         sequential navigation start point. Current browsers do the latter
         correctly on their own. A screen reader virtual cursor historically
         did not follow a target it could not focus, and one attribute removes
         the question. */
    }
    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <SiteFooter locale={locale} />

    <style is:global>
      /* Single shared definition in src/styles/skip-link.css, referenced with
         @import rather than copy-pasted: OperationsLayout.astro renders the
         same link and imports the same file, so the two cannot drift into
         two different looks or two different focus behaviours. is:global
         because a scoped `.lw-skip-link` rule would be harmless here (the
         link lives in this same file) but there is no reason to scope a
         shared utility class at all. */
      @import '../styles/skip-link.css';
    </style>
    <style>
      body {
        display: flex;
        min-height: 100vh;
        min-height: 100dvh;
        flex-direction: column;
      }

      main {
        flex: 1;
        padding-block: var(--space-8) var(--space-16);
      }
    </style>
  </body>
</html>
